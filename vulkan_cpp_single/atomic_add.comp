#version 450

layout(local_size_x = 256) in;

// Keep these aligned with the workload constants in main.cpp.
const uint ADDS_PER_THREAD = 1024u;
const uint SLOT_COUNT = (8u * 1024u * 1024u) / 4u;
const uint THREAD_COUNT = 4096u * 256u;

layout(std430, binding = 0) buffer Counters {
    uint counters[];
};

uint hash_u32(uint input_value) {
    uint value = input_value;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    for (uint i = 0u; i < ADDS_PER_THREAD; ++i) {
        uint key = id + i * THREAD_COUNT;
        uint index = hash_u32(key) % SLOT_COUNT;
        atomicAdd(counters[index], 1u);
    }
}
